
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: Einzelne Datei starten (F11)",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/d",
                "/c",
                "call",
                "run-c.bat",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "C: Ganzes Projekt starten (F12)",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/d",
                "/c",
                "call",
                "run-c-folder.bat",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        }
    ]
}
