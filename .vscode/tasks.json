
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: Aktuelle Datei starten (F11)",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/d",
                "/c",
                "call",
                "run-c.bat",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "C:\\Windows\\System32\\cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        }
    ]
}
